{
  "allow_private_networks": true,
  "storage": {
    "workspace": "~/.openviking/data"
  },
  "embedding": {
    "dense": {
      "provider": "openai",
      "model": "Qwen3-Embedding-4B",
      "api_key": "<secret>",
      "api_base": "<private>",
      "dimension": 1024,
      "query_param": "query"
    },
    "max_concurrent": 20,
    "max_retries": 6
  },
  "vlm": {
    "provider": "volcengine",
    "model": "<private>",
    "api_base": "<private>",
    "temperature": 0.0,
    "max_retries": 5,
    "timeout": 1800.0,
    "api_key": "<secret>",
    "max_tokens": 40000
  },
  "server": {
    "host": "::",
    "port": 1933,
    "root_api_key": "<secret>",
    "agent_evolution": {
      "enabled": true
    }
  },
  "log": {
    "level": "WARNING",
    "output": "~/.openviking/logs/openviking.log",
    "rotation": true,
    "rotation_days": 7,
    "rotation_interval": "midnight",
    "model_calls_output": "~/.openviking/logs/model-calls.jsonl"
  },
  "retrieval": {
    "recall_intent_timeout_s": 20.0
  },
  "queue_workers": {
    "session_commit": {
      "max_concurrent": 12
    }
  },
  "memory": {
    "eager_prefetch": false,
    "extraction_input_token_budget": 160000,
    "extraction_read_token_budget": 16000,
    "session_auto_commit": {
      "enabled": true
    },
    "extraction_output_format": "json"
  },
  "pdf": {
    "strategy": "mineru",
    "mineru_endpoint": "http://127.0.0.1:8666",
    "mineru_timeout": 900.0
  },
  "bot": {
    "ov_server": {
      "api_key": "<secret>",
      "api_key_type": "user"
    }
  },
  "query_planner": {
    "provider": "volcengine",
    "model": "<private>",
    "api_base": "<private>",
    "temperature": 0.0,
    "max_retries": 5,
    "timeout": 300.0,
    "api_key": "<secret>"
  }
}
